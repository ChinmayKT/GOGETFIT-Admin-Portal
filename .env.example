# Backend server for the portal. Committed per-mode values live in
# .env.development (npm run dev) and .env.staging (npm run build -- --mode staging);
# copy this file to .env.<mode>.local for a personal override.
#
# A bare server origin gets the backend's /api prefix appended automatically.
# Set it to /api instead to route requests through the Vite dev proxy
# (same-origin, see vite.config.ts) rather than calling the backend directly.
#
# VITE_* values are inlined into the shipped JavaScript - never put secrets here.
VITE_API_BASE_URL=http://localhost:3000

# Optional: where /uploads/... media loads from. Defaults to the origin of
# VITE_API_BASE_URL (or the portal's own origin when that is /api).
# VITE_MEDIA_BASE_URL=

# Where the dev proxy forwards /api and /uploads when VITE_API_BASE_URL=/api.
VITE_API_PROXY_TARGET=http://localhost:3000
